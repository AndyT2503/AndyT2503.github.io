    "ngx-markdown": "^21.2.9",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.9",
    "@netlify/angular-runtime": "^3.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
