{
  "name": "new-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "start": "ng serve --port 4500",
    "build": "npx ng run new-portfolio:build-generate-404-page",
    "postbuild": "node scripts/prerender-seo.js",
    "generate-sitemap": "node scripts/generate-sitemap.js",
