{
  "name": "new-portfolio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "start": "ng serve --port 4500",
    "build": "ng build",
    "serve:ssr": "ng build && node dist/server/server.mjs",
